  function injectStyle() {
    if (document.getElementById('vsm-fusion-style')) return;
    const s = document.createElement('style');
    s.id = 'vsm-fusion-style';
    s.textContent = CSS;
    (document.head || document.documentElement).appendChild(s);
  }

  /* ============================================================
   *  七、快捷选择面板
   * ============================================================ */

  let quickPanelEl = null;
  let quickButtons = {};      // person -> button
  const quickDragStates = {}; // person -> drag state
  let orderedPersons = [];

  let rebuildLock = false;

  function findRowByPerson(personName) {
    const rows = document.querySelectorAll(SEL_ROW);
    for (let i = 0; i < rows.length; i++) {
      const label = rows[i].querySelector(SEL_LABEL);
      if (label && label.textContent.trim() === personName) {
        const panel = rows[i].closest('.lsf-ann-side-panel__region-tree-list');
        if (panel) return rows[i];
      }
    }
    return null;
  }

  function activatePerson(personName) {
    const targetRow = findRowByPerson(personName);
    if (!targetRow) return;

    const rows = document.querySelectorAll(SEL_ROW);
    rows.forEach(function (row) {
      row.classList.remove(ACTIVE_ROW);
      const itemBtn = row.querySelector(SEL_ITEM_BTN);
      if (itemBtn) {
        itemBtn.classList.remove(ACTIVE_ITEM);
        itemBtn.setAttribute('aria-pressed', 'false');
      }
    });

    targetRow.classList.add(ACTIVE_ROW);
    const targetItem = targetRow.querySelector(SEL_ITEM_BTN);
    if (targetItem) {
      targetItem.classList.add(ACTIVE_ITEM);
      targetItem.setAttribute('aria-pressed', 'true');
      try { targetItem.click(); } catch (e) {}
    }
    updateQuickActiveState(personName);
  }

  function updateQuickActiveState(activePerson) {
    Object.keys(quickButtons).forEach(function (person) {
      const btn = quickButtons[person];
      if (!btn) return;
      if (person === activePerson) btn.classList.add('active');
      else btn.classList.remove('active');
    });
  }

  function initQuickActiveState() {
    const activeRow = document.querySelector('.' + ACTIVE_ROW);
    if (activeRow) {
      const label = activeRow.querySelector(SEL_LABEL);
      if (label) updateQuickActiveState(label.textContent.trim());
    } else {
      updateQuickActiveState(null);
    }
  }

  function detachQuickButton(person) {
    const btn = quickButtons[person];
    if (!btn || btn.classList.contains('vsm-quick-btn-detached')) return;
    const rect = btn.getBoundingClientRect();
    if (btn.parentNode) btn.parentNode.removeChild(btn);
    btn.classList.add('vsm-quick-btn-detached');
    document.body.appendChild(btn);
    btn.style.left = rect.left + 'px';
    btn.style.top = rect.top + 'px';
    btn.style.right = 'auto';
    btn.style.bottom = 'auto';
    savePosition(POS_KEY_QUICK_ITEM + person, rect.left, rect.top);
    bindDetachedButtonDrag(btn, person);
  }

  function attachQuickButton(person) {
    const btn = quickButtons[person];
    if (!btn || !btn.classList.contains('vsm-quick-btn-detached')) return;
    if (quickDragStates[person]) {
      const ds = quickDragStates[person];
      if (ds.cleanup) ds.cleanup();
      delete quickDragStates[person];
    }
    btn.classList.remove('vsm-quick-btn-detached');
    btn.style.left = '';
    btn.style.top = '';
    btn.style.right = '';
    btn.style.bottom = '';

    const existing = Array.prototype.filter.call(
      quickPanelEl.querySelectorAll('.vsm-quick-btn'),
      function (b) { return b.parentNode === quickPanelEl; }
    );
    const personIndex = orderedPersons.indexOf(person);
    let inserted = false;
    for (let i = 0; i < existing.length; i++) {
      const otherPerson = existing[i].dataset.person;
      const otherIndex = orderedPersons.indexOf(otherPerson);
      if (otherIndex > personIndex) {
        quickPanelEl.insertBefore(btn, existing[i]);
        inserted = true;
        break;
      }
    }
    if (!inserted) {
      if (existing.length > 0) {
        const last = existing[existing.length - 1];
        if (last.nextSibling) quickPanelEl.insertBefore(btn, last.nextSibling);
        else quickPanelEl.appendChild(btn);
      } else {
        const handle = quickPanelEl.querySelector('.vsm-drag-handle');
        if (handle && handle.nextSibling) quickPanelEl.insertBefore(btn, handle.nextSibling);
        else quickPanelEl.appendChild(btn);
      }
    }
    try { localStorage.removeItem(POS_KEY_QUICK_ITEM + person); } catch (e) {}
    initQuickActiveState();
  }

  function bindDetachedButtonDrag(btn, person) {
    if (quickDragStates[person]) {
      const old = quickDragStates[person];
      if (old.cleanup) old.cleanup();
    }
    let dragging = false, moved = false, startPt = null, startRect = null;
    let cleanupFns = [];

    function onMouseDown(e) {
      if (e.button !== 0) return;
      dragging = true;
      moved = false;
      startPt = { x: e.clientX, y: e.clientY };
      const r = btn.getBoundingClientRect();
      startRect = { left: r.left, top: r.top };
      e.preventDefault();
      e.stopPropagation();
    }
    function onMouseMove(e) {
      if (!dragging) return;
      const dx = e.clientX - startPt.x, dy = e.clientY - startPt.y;
      if (!moved && Math.abs(dx) < 4 && Math.abs(dy) < 4) return;
      moved = true;
      const w = btn.offsetWidth, h = btn.offsetHeight;
      const nx = Math.max(0, Math.min(startRect.left + dx, window.innerWidth - w));
      const ny = Math.max(0, Math.min(startRect.top + dy, window.innerHeight - h));
      btn.style.left = nx + 'px';
      btn.style.top = ny + 'px';
      btn.style.right = 'auto';
      btn.style.bottom = 'auto';
    }
    function onMouseUp(e) {
      if (!dragging) return;
      dragging = false;
      if (moved) {
        savePosition(POS_KEY_QUICK_ITEM + person, parseFloat(btn.style.left), parseFloat(btn.style.top));
      }
      setTimeout(function () { moved = false; }, 0);
    }
    function onDblClick(e) {
      if (moved) return;
      e.stopPropagation();
      attachQuickButton(person);
    }
    function onContextMenu(e) {
      e.preventDefault();
      e.stopPropagation();
      attachQuickButton(person);
    }

    btn.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);
    btn.addEventListener('dblclick', onDblClick);
    btn.addEventListener('contextmenu', onContextMenu);

    cleanupFns.push(function () {
      btn.removeEventListener('mousedown', onMouseDown);
      document.removeEventListener('mousemove', onMouseMove);
      document.removeEventListener('mouseup', onMouseUp);
      btn.removeEventListener('dblclick', onDblClick);
      btn.removeEventListener('contextmenu', onContextMenu);
    });

    quickDragStates[person] = {
      cleanup: function () { cleanupFns.forEach(function (fn) { fn(); }); }
    };
  }

  // 按钮内容：数字 = 人物编号，无角标
  function updateButtonContent(btn, person) {
    const num = getPersonNumber(person);
    const mainText = num != null ? String(num) : person;
    let mainSpan = btn.querySelector('.vsm-btn-main');
    if (!mainSpan) {
      btn.innerHTML = '';
      mainSpan = document.createElement('span');
      mainSpan.className = 'vsm-btn-main';
      btn.appendChild(mainSpan);
    }
    if (mainSpan.textContent !== mainText) mainSpan.textContent = mainText;

    // 去掉可能残留的角标
    const hotkeyEl = btn.querySelector('.vsm-hotkey');
    if (hotkeyEl && hotkeyEl.parentNode) hotkeyEl.parentNode.removeChild(hotkeyEl);

    const titleText = '左键选择 ' + person + (num != null ? '（快捷键 ' + num + '）' : '') + '，右键拖出';
    if (btn.title !== titleText) btn.title = titleText;
  }

  function createQuickButton(person) {
    const btn = document.createElement('button');
    btn.className = 'vsm-quick-btn';
    btn.dataset.person = person;
    updateButtonContent(btn, person);

    btn.addEventListener('click', function (e) {
      if (e.detail > 1) return;
      e.stopPropagation();
      activatePerson(person);
    });
    btn.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      e.stopPropagation();
      detachQuickButton(person);
    });
    return btn;
  }

  function clearPanelButtons() {
    if (!quickPanelEl) return;
    const btns = quickPanelEl.querySelectorAll('.vsm-quick-btn');
    btns.forEach(function (b) {
      if (b.parentNode) b.parentNode.removeChild(b);
    });
  }

  // 重建：只认当前列表里真实存在的人物
  function rebuildQuickPanel() {
    if (rebuildLock) return;
    rebuildLock = true;
    try {
      if (!quickPanelEl) return;

      const persons = getPersonNames();   // 空白帧 → []
      orderedPersons = persons.slice();

      // 收集已 detached 的按钮
      const detachedMap = {};
      Object.keys(quickButtons).forEach(function (p) {
        const b = quickButtons[p];
        if (b && b.classList.contains('vsm-quick-btn-detached')) {
          detachedMap[p] = b;
        }
      });

      // 彻底清理面板内旧按钮
      clearPanelButtons();

      // 清理 quickButtons 里非 detached 的引用
      Object.keys(quickButtons).forEach(function (p) {
        if (!detachedMap[p]) delete quickButtons[p];
      });

      // 处理已不在人物列表里的 detached 按钮：移除
      Object.keys(detachedMap).forEach(function (p) {
        if (persons.indexOf(p) < 0) {
          const b = detachedMap[p];
          if (b && b.parentNode) b.parentNode.removeChild(b);
          delete detachedMap[p];
          delete quickButtons[p];
        }
      });

      // 重建面板内按钮
      const handle = quickPanelEl.querySelector('.vsm-drag-handle');
      persons.forEach(function (person) {
        if (detachedMap[person]) return; // 已 detached 的不重建
        const btn = createQuickButton(person);
        quickButtons[person] = btn;
        if (handle && handle.nextSibling) quickPanelEl.insertBefore(btn, handle.nextSibling);
        else quickPanelEl.appendChild(btn);
      });

      // 恢复之前脱离的按钮位置（延迟到 DOM 插入后）
      persons.forEach(function (person) {
        const savedBtnPos = loadPosition(POS_KEY_QUICK_ITEM + person);
        if (savedBtnPos && quickButtons[person]) {
          setTimeout(function () {
            const btn = quickButtons[person];
            if (btn && !btn.classList.contains('vsm-quick-btn-detached')) {
              detachQuickButton(person);
              const w = btn.offsetWidth, h = btn.offsetHeight;
              const nx = Math.max(0, Math.min(savedBtnPos.left, window.innerWidth - w));
              const ny = Math.max(0, Math.min(savedBtnPos.top, window.innerHeight - h));
              btn.style.left = nx + 'px';
              btn.style.top = ny + 'px';
              savePosition(POS_KEY_QUICK_ITEM + person, nx, ny);
            }
          }, 0);
        }
      });

      initQuickActiveState();
    } finally {
      rebuildLock = false;
    }
  }

  function createQuickPanel() {
    if (quickPanelEl) return;
    quickPanelEl = document.createElement('div');
    quickPanelEl.className = 'vsm-panel vsm-quick-panel';
    quickPanelEl.id = 'vsm-quick-panel';

    const handle = document.createElement('span');
    handle.className = 'vsm-drag-handle';
    handle.textContent = '⋮⋮';
    handle.title = '拖动面板';
    quickPanelEl.appendChild(handle);

    document.body.appendChild(quickPanelEl);

    // ① 先绑定拖动
    makeDraggable(quickPanelEl, {
      saveKey: POS_KEY_QUICK,
      dragHandleSelector: '.vsm-drag-handle'
    });

    // ② 重建按钮，让面板宽度稳定
    rebuildQuickPanel();

    // ③ 最后再应用保存的位置（此时 offsetWidth 已经包含所有按钮）
    const savedPos = loadPosition(POS_KEY_QUICK);
    applyPosition(quickPanelEl, savedPos, 24, 24);
  }

  /* ============================================================
   *  八、状态助手面板
   * ============================================================ */

  let rootEl = null, moreEl = null, checkEl = null, moreOpen = false;

  function getActiveTool() {
    const moveBtn = document.querySelector('.lsf-tool[aria-label="move-tool"]');
    const panBtn = document.querySelector('.lsf-tool[aria-label="pan"]');
    const moveActive = !!(moveBtn && moveBtn.classList.contains('lsf-tool_active'));
    const panActive = !!(panBtn && panBtn.classList.contains('lsf-tool_active'));
    if (moveActive) return 'move';
    if (panActive) return 'pan';
    return 'none';
  }

  function updateCheckButton() {
    if (!checkEl) return;
    const tool = getActiveTool();
    if (tool === 'move') {
      if (checkEl.textContent !== '🖱️') checkEl.textContent = '🖱️';
      checkEl.classList.remove('vsm-check-red');
      checkEl.title = '当前：移动工具（点击查看其他标注）';
    } else if (tool === 'pan') {
      if (checkEl.textContent !== '🖐️') checkEl.textContent = '🖐️';
      checkEl.classList.remove('vsm-check-red');
      checkEl.title = '当前：拖动图像（点击查看其他标注）';
    } else {
      if (checkEl.textContent !== '✓') checkEl.textContent = '✓';
      checkEl.classList.add('vsm-check-red');
      checkEl.title = '未选择工具（点击查看其他标注）';
    }
  }

  function chipOf(key) { return rootEl ? rootEl.querySelector('.vsm-chip[data-key="' + key + '"]') : null; }

  function toggleMainDropdown(chip, cfg) {
    if (currentAnchorEl === chip && currentDropdown) { closeDropdown(); return; }
    const st = readGroup(cfg.title);
    if (!st) return;
    const items = st.inputs.map(function (inp) {
      const raw = labelTextOf(inp);
      return {
        text: prettyText(raw, cfg.map),
        isChecked: function () { return isChecked(inp); },
        select: function () { clickOption(cfg.title, raw); }
      };
    });
    showDropdown(chip, items, { multi: false });
  }

  function toggleItemDropdown(chip) {
    if (currentAnchorEl === chip && currentDropdown) { closeDropdown(); return; }
    const ig = findItemGroup();
    if (!ig) return;
    const inputs = ig.querySelectorAll('input.ant-checkbox-input');
    const items = [];
    for (let i = 0; i < inputs.length; i++) (function (inp) {
      const raw = labelTextOf(inp);
      items.push({
        text: flipLR(raw),
        isChecked: function () { return isChecked(inp); },
        select: function () { try { inp.click(); } catch (e) {} }
      });
    })(inputs[i]);
    showDropdown(chip, items, { multi: true });
  }

  function toggleMore() {
    moreOpen = !moreOpen;
    checkEl.classList.toggle('vsm-active', moreOpen);
    moreEl.style.display = moreOpen ? 'flex' : 'none';
    closeDropdown();
    if (moreOpen) renderMore();
  }

  function renderMain() {
    if (!rootEl) return;
    updateCheckButton();

    const ig = findItemGroup();
    const iv = !!(ig && isVisible(ig));

    MAIN_GROUPS.forEach(function (cfg) {
      const chip = chipOf(cfg.key);
      if (!chip) return;
      const st = readGroup(cfg.title);
      if (!st) { chip.style.display = 'none'; return; }
      chip.style.display = '';
      const txtEl = chip.querySelector('.vsm-chip-text');
      let text = '—';
      if (st.checked.length) {
        const vals = st.checked.map(function (inp) { return prettyText(labelTextOf(inp), cfg.map); });
        if (vals.length === 1 && vals[0] === '❌') text = cfg.short + '：❌';
        else text = vals.join('/');
      }
      if (txtEl.textContent !== text) txtEl.textContent = text;
      chip.classList.toggle('vsm-none', text === '—');
    });

    renderItemChip(ig, iv);
  }

  function renderItemChip(ig, visible) {
    let chip = document.getElementById('vsm-item-chip');
    if (!visible) { if (chip) chip.style.display = 'none'; return; }
    if (!chip) {
      chip = document.createElement('span');
      chip.id = 'vsm-item-chip';
      chip.className = 'vsm-chip vsm-item';
      chip.innerHTML = '<span class="vsm-chip-text">—</span>';
      chip.addEventListener('click', function (e) { e.stopPropagation(); toggleItemDropdown(chip); });
      rootEl.insertBefore(chip, checkEl);
    }
    chip.style.display = '';
    const inputs = ig.querySelectorAll('input.ant-checkbox-input');
    const checked = [];
    for (let i = 0; i < inputs.length; i++) if (isChecked(inputs[i])) checked.push(labelTextOf(inputs[i]));
    const txtEl = chip.querySelector('.vsm-chip-text');
    let text = '—';
    if (checked.length) text = checked.map(flipLR).join('/');
    if (txtEl.textContent !== text) txtEl.textContent = text;
    chip.classList.toggle('vsm-none', text === '—');
  }

  function renderMore() {
    if (!moreEl) return;
    moreEl.innerHTML = '';

    let visibleCount = 0;
    OTHER_GROUPS.forEach(function (cfg) {
      const st = readGroup(cfg.title);
      if (!st) return;
      visibleCount++;

      const tag = document.createElement('div');
      tag.className = 'vsm-tag';
      tag.setAttribute('data-title', cfg.title);
      tag.title = cfg.title + '（点击切换）';

      let text = '—';
      if (st.checked.length) {
        const vals = st.checked.map(function (inp) { return flipLR(labelTextOf(inp)); });
        if (vals.length === 1) {
          if (isNoneLike(vals[0])) text = cfg.short + '：无';
          else if (isXLike(vals[0])) text = cfg.short + '：❌';
          else text = vals[0];
        } else text = vals.join('/');
      } else tag.classList.add('vsm-none');
      tag.textContent = text;

      moreEl.appendChild(tag);
    });

    if (visibleCount === 0) {
      const empty = document.createElement('div');
      empty.className = 'vsm-tag vsm-none';
      empty.textContent = '未识别到可用分组';
      moreEl.appendChild(empty);
    }

    const btn = document.createElement('div');
    btn.className = 'vsm-tag vsm-action';
    btn.textContent = '后续帧';
    btn.title = '把当前对象已填的属性批量覆盖到它在其它帧的标注上';
    moreEl.appendChild(btn);
  }

  function renderAll() {
    renderMain();
    if (moreOpen) renderMore();
    initQuickActiveState();
  }

  function createMainPanel() {
    if (rootEl) return;
    rootEl = document.createElement('div');
    rootEl.className = 'vsm-panel vsm-main-panel';
    rootEl.id = 'vsm-main-panel';

    const handle = document.createElement('span');
    handle.className = 'vsm-drag-handle';
    handle.textContent = '⋮⋮';
    handle.title = '拖动面板';
    rootEl.appendChild(handle);

    MAIN_GROUPS.forEach(function (cfg) {
      const chip = document.createElement('span');
      chip.className = 'vsm-chip vsm-none';
      chip.dataset.key = cfg.key;
      chip.innerHTML = '<span class="vsm-chip-text">—</span>';
      chip.addEventListener('click', function (e) {
        e.stopPropagation();
        toggleMainDropdown(chip, cfg);
      });
      rootEl.appendChild(chip);
    });

    checkEl = document.createElement('span');
    checkEl.className = 'vsm-check';
    checkEl.textContent = '✓';
    checkEl.title = '查看其他标注';
    checkEl.addEventListener('click', function (e) {
      e.stopPropagation();
      toggleMore();
    });
    rootEl.appendChild(checkEl);

    moreEl = document.createElement('div');
    moreEl.className = 'vsm-more';
    moreEl.style.display = 'none';
    moreEl.addEventListener('scroll', closeDropdown);

    moreEl.addEventListener('mousedown', function (e) {
      const tag = e.target.closest ? e.target.closest('.vsm-tag') : null;
      if (!tag) return;
      e.stopPropagation();
      e.preventDefault();

      if (tag.classList.contains('vsm-action')) {
        if (currentAnchorEl === tag && currentDropdown) { closeDropdown(); return; }
        const ok = triggerOverrideNextFrames();
        if (!ok) {
          tag.textContent = '未找到按钮';
          tag.classList.add('vsm-done');
          setTimeout(function () { tag.textContent = '后续帧'; tag.classList.remove('vsm-done'); }, 1200);
          return;
        }
        tag.textContent = '已覆盖 ✓';
        tag.classList.add('vsm-done');
        setTimeout(function () { tag.textContent = '后续帧'; tag.classList.remove('vsm-done'); }, 1200);
        return;
      }

      const title = tag.getAttribute('data-title');
      if (!title) return;
      if (currentAnchorEl === tag && currentDropdown) { closeDropdown(); return; }
      const cur = readGroup(title);
      if (!cur) return;
      const items = cur.inputs.map(function (inp) {
        const raw = labelTextOf(inp);
        return {
          text: flipLR(raw),
          isChecked: function () { return isChecked(inp); },
          select: function () { clickOption(title, raw); }
        };
      });
      showDropdown(tag, items, { multi: false });
    });

    rootEl.appendChild(moreEl);
    document.body.appendChild(rootEl);

    const savedPos = loadPosition(POS_KEY_MAIN);
    applyPosition(rootEl, savedPos, 24, 24);

    makeDraggable(rootEl, {
      saveKey: POS_KEY_MAIN,
      dragHandleSelector: '.vsm-drag-handle'
    });

    updateCheckButton();
  }

  /* ============================================================
   *  九、数字快捷键（快捷键 = 人物编号）
   * ============================================================ */

  function isEditableTarget(el) {
    if (!el) return false;
    const tag = el.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
    if (el.isContentEditable) return true;
    if (el.closest && el.closest('[contenteditable="true"]')) return true;
    return false;
  }

  function handleHotkey(e) {
    if (e.ctrlKey || e.altKey || e.metaKey) return;
    if (isEditableTarget(e.target)) return;
    if (e.key < '1' || e.key > String(MAX_HOTKEY)) return;
    const num = parseInt(e.key, 10);
    if (isNaN(num)) return;

    let targetPerson = null;
    for (let i = 0; i < orderedPersons.length; i++) {
      if (getPersonNumber(orderedPersons[i]) === num) {
        targetPerson = orderedPersons[i];
        break;
      }
    }
    if (!targetPerson) return;

    e.preventDefault();
    e.stopPropagation();
    activatePerson(targetPerson);
  }

  document.addEventListener('keydown', handleHotkey, true);

  /* ============================================================
   *  十、监听 & 启动
   * ============================================================ */

  function startObserver() {
    let rafId = null;
    const mo = new MutationObserver(function () {
      if (rafId) return;
      rafId = requestAnimationFrame(function () {
        rafId = null;
        renderAll();
        rebuildQuickPanel();
      });
    });
    mo.observe(document.body, {
      childList: true, subtree: true, attributes: true,
      attributeFilter: ['aria-pressed', 'class', 'checked', 'title']
    });
    setInterval(function () {
      renderAll();
      rebuildQuickPanel();
    }, 800);
  }

  function boot() {
    injectStyle();
    createQuickPanel();
    createMainPanel();
    renderAll();
    startObserver();

    setTimeout(initQuickActiveState, 200);
    setTimeout(initQuickActiveState, 800);

    window.addEventListener('resize', function () {
      closeDropdown();
      [quickPanelEl, rootEl].forEach(function (el) {
        if (!el) return;
        if (!el.style.left || el.style.left === 'auto') return;
        const w = el.offsetWidth, h = el.offsetHeight;
        const nx = Math.max(0, Math.min(parseFloat(el.style.left) || 0, window.innerWidth - w));
        const ny = Math.max(0, Math.min(parseFloat(el.style.top) || 0, window.innerHeight - h));
        el.style.left = nx + 'px';
        el.style.top = ny + 'px';
      });
    });
  }

  if (document.body) boot();
  else document.addEventListener('DOMContentLoaded', boot);
})();
