// ==UserScript==
// @name         🚥
// @namespace    local.vsm
// @version      5.7.0
// @description  动态识别人物并快捷选择（快捷键=人物编号/右键脱离/双击拖回）+ 标注状态常驻助手，两个横向面板，均可拖动、记忆位置、识别不到自动隐藏
// @include      /^https?:\/\/221\.2\.217\.94(:\d+)?\//
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
  'use strict';
  if (window.__vsmFusionLoaded) return;
  window.__vsmFusionLoaded = true;

  /* ============================================================
   *  一、公共配置
   * ============================================================ */

  const MAIN_GROUPS = [
    { key: 'head', short: '头', title: '头部姿势', map: { '左转': '👉转', '右转': '👈转', '正视': '正视', '低头': '低头', '抬头': '抬头', '难以判断': '❌' } },
    { key: 'gaze', short: '视线', title: '视线方向', map: { '前视': '前看', '左视': '👉看', '右视': '👈看', '其他': '❌' } },
    { key: 'eye', short: '眼', title: '疲劳程度-眼部状态', map: { '正常睁眼': '睁眼', '半闭': '半睁', '闭眼': '闭眼', '难以判断': '❌' } },
    { key: 'mouth', short: '嘴', title: '疲劳程度-嘴部状态', map: { '闭合': '闭嘴', '微微张开': '微张', '大张': '张嘴', '难以判断': '❌' } },
    { key: 'emotion', short: '情绪', title: '情绪', map: { '平静': '平静', '高兴': '高兴', '悲伤': '难过', '愤怒': '生气', '恐惧': '害怕', '厌恶': '讨厌', '惊讶': '惊讶', '难以判断': '❌' } }
  ];

  const OTHER_GROUPS = [
    { title: '驾驶员手部姿态', short: '方向盘' },
    { title: '日常乘坐行为', short: '行为' },
    { title: '抽烟与明火', short: '抽烟' },
    { title: '手势类别', short: '手势' },
    { title: '是否相似物负样本', short: '负样本' },
    { title: '驾驶区域入侵', short: '入侵' }
  ];

  const ITEM_HINTS = ['饮料瓶', '纸巾盒', '笔记本电脑', '儿童安全座椅', '婴儿座椅', '毛绒玩具'];

  const POS_KEY_MAIN = 'vsm_fusion_main_pos_v3';
  const POS_KEY_QUICK = 'vsm_fusion_quick_pos_v3';
  const POS_KEY_QUICK_ITEM = 'vsm_fusion_quick_item_v3_';

  const SEL_ROW = '.lsf-ann-side-panel__region-tree-row';
  const SEL_LABEL = '.lsf-ann-side-panel__region-tree-label';
  const SEL_ITEM_BTN = '.lsf-ann-side-panel__region-tree-item';
  const ACTIVE_ROW = 'lsf-ann-side-panel__region-tree-row_active';
  const ACTIVE_ITEM = 'lsf-ann-side-panel__region-tree-item_active';

  const MAX_HOTKEY = 6;

  /* ============================================================
   *  二、通用工具函数
   * ============================================================ */

  function isVisible(el) {
    if (!el) return false;
    const s = window.getComputedStyle(el);
    if (s.display === 'none' || s.visibility === 'hidden') return false;
    const r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0;
  }
  function flipLR(t) { return String(t).replace(/左侧/g, '👉').replace(/右侧/g, '👈').replace(/左/g, '👉').replace(/右/g, '👈'); }
  function prettyText(raw, map) { return (map && map[raw] != null) ? map[raw] : flipLR(raw); }
  function isNoneLike(v) { return /^无$/.test(String(v).trim()); }
  function isXLike(v) { return /^(难以判断|无法判断|无法判定|未知|unkown|unknown|其他)$/i.test(String(v).trim()); }

  function getPersonNumber(personName) {
    const m = String(personName).match(/\d+/);
    if (!m) return null;
    const n = parseInt(m[0], 10);
    if (isNaN(n)) return null;
    return n;
  }

  function findGroupEl(title) {
    const ts = document.querySelectorAll('.lsf-ann-side-panel__section-title_attribute');
    for (let i = 0; i < ts.length; i++) if (ts[i].textContent.trim() === title) return ts[i].closest('.lsf-ann-side-panel__region-attribute-group');
    return null;
  }
  function findItemGroup() {
    const cs = document.querySelectorAll('.lsf-ann-side-panel__rendered-control_region');
    for (let i = 0; i < cs.length; i++) {
      const inputs = cs[i].querySelectorAll('input.ant-checkbox-input');
      if (!inputs.length) continue;
      let hit = 0;
      for (let j = 0; j < inputs.length; j++) if (ITEM_HINTS.indexOf(inputs[j].name) >= 0) hit++;
      if (hit >= 2) return cs[i];
    }
    return null;
  }
  function labelTextOf(input) {
    const l = input.closest('label');
    if (!l) return input.name || '';
    const s = Array.prototype.filter.call(l.children, function (el) { return el.tagName === 'SPAN'; });
    const last = s[s.length - 1];
    return last ? last.textContent.trim() : (input.name || '');
  }
  function isChecked(input) {
    if (input.checked) return true;
    const l = input.closest('label');
    return !!(l && l.classList.contains('ant-checkbox-wrapper-checked'));
  }
  function readGroup(title) {
    const g = findGroupEl(title);
    if (!g) return null;
    const inputs = Array.prototype.slice.call(g.querySelectorAll('input.ant-checkbox-input'));
    return { group: g, inputs: inputs, checked: inputs.filter(isChecked) };
  }
  function clickOption(title, rawText) {
    const st = readGroup(title);
    if (!st) return;
    let target = null;
    for (let i = 0; i < st.inputs.length; i++) if (labelTextOf(st.inputs[i]) === rawText) { target = st.inputs[i]; break; }
    if (!target) return;
    if (isChecked(target)) { try { target.click(); } catch (e) {} return; }
    try { target.click(); } catch (e) {}
    setTimeout(function () {
      st.inputs.forEach(function (inp) {
        if (inp !== target && isChecked(inp)) { try { inp.click(); } catch (e) {} }
      });
    }, 60);
  }
  function triggerOverrideNextFrames() {
    const bs = document.querySelectorAll('.lsf-ann-side-panel__attr-override-button');
    for (let i = 0; i < bs.length; i++) if (bs[i].textContent.trim() === '后续帧') { try { bs[i].click(); return true; } catch (e) { return false; } }
    return false;
  }

  // 只从“全部目标”列表里读取人物（切帧时这个列表会同步更新）
  function getPersonNames() {
    const rows = document.querySelectorAll(SEL_ROW);
    const names = [];
    rows.forEach(function (row) {
      const panel = row.closest('.lsf-ann-side-panel__region-tree-list');
      if (!panel) return;
      const label = row.querySelector(SEL_LABEL);
      if (label) {
        const t = label.textContent.trim();
        if (t && names.indexOf(t) < 0) names.push(t);
      }
    });
    return names;
  }

  /* ============================================================
   *  三、位置记忆
   * ============================================================ */

  function savePosition(k, l, t) { try { localStorage.setItem(k, JSON.stringify({ left: l, top: t })); } catch (e) {} }
  function loadPosition(k) {
    try {
      const r = localStorage.getItem(k);
      if (!r) return null;
      const p = JSON.parse(r);
      if (p && typeof p.left === 'number' && typeof p.top === 'number') return p;
    } catch (e) {}
    return null;
  }
  function applyPosition(el, pos, defRight, defBottom) {
    if (pos) {
      const w = el.offsetWidth, h = el.offsetHeight;
      const nx = Math.max(0, Math.min(pos.left, window.innerWidth - w));
      const ny = Math.max(0, Math.min(pos.top, window.innerHeight - h));
      el.style.left = nx + 'px';
      el.style.top = ny + 'px';
      el.style.right = 'auto';
      el.style.bottom = 'auto';
    } else {
      el.style.left = 'auto';
      el.style.top = 'auto';
      if (defRight != null) el.style.right = defRight + 'px';
      if (defBottom != null) el.style.bottom = defBottom + 'px';
    }
  }

  /* ============================================================
   *  四、拖拽逻辑
   * ============================================================ */

  function makeDraggable(el, options) {
    options = options || {};
    const saveKey = options.saveKey || null;
    const onDragStart = options.onDragStart || null;
    const onDragEnd = options.onDragEnd || null;
    const dragHandleSelector = options.dragHandleSelector || null;

    let dragging = false, moved = false, startPt = null, startRect = null;

    el.addEventListener('mousedown', function (e) {
      if (e.button !== 0) return;
      if (dragHandleSelector && !(e.target.closest && e.target.closest(dragHandleSelector))) return;
      if (e.target.closest && (e.target.closest('.vsm-dropdown') || e.target.closest('.vsm-tag') || e.target.closest('.vsm-chip') || e.target.closest('button'))) return;
      dragging = true;
      moved = false;
      startPt = { x: e.clientX, y: e.clientY };
      const r = el.getBoundingClientRect();
      startRect = { left: r.left, top: r.top };
      e.preventDefault();
      if (onDragStart) onDragStart();
    });

    document.addEventListener('mousemove', function (e) {
      if (!dragging) return;
      const dx = e.clientX - startPt.x, dy = e.clientY - startPt.y;
      if (!moved && Math.abs(dx) < 4 && Math.abs(dy) < 4) return;
      moved = true;
      const w = el.offsetWidth, h = el.offsetHeight;
      const nx = Math.max(0, Math.min(startRect.left + dx, window.innerWidth - w));
      const ny = Math.max(0, Math.min(startRect.top + dy, window.innerHeight - h));
      el.style.left = nx + 'px';
      el.style.top = ny + 'px';
      el.style.right = 'auto';
      el.style.bottom = 'auto';
    });

    document.addEventListener('mouseup', function () {
      if (!dragging) return;
      dragging = false;
      if (moved) {
        if (saveKey && el.style.left && el.style.left !== 'auto') {
          savePosition(saveKey, parseFloat(el.style.left), parseFloat(el.style.top));
        }
        if (onDragEnd) onDragEnd();
      }
      setTimeout(function () { moved = false; }, 0);
    });

    return {
      isMoved: function () { return moved; },
      resetMoved: function () { moved = false; }
    };
  }

  /* ============================================================
   *  五、下拉菜单（共享）
   * ============================================================ */

  let currentDropdown = null, currentAnchorEl = null;

  function closeDropdown() {
    if (currentDropdown) {
      currentDropdown.remove();
      currentDropdown = null;
      currentAnchorEl = null;
    }
  }
  function showDropdown(anchorEl, items, opts) {
    opts = opts || {};
    const multi = !!opts.multi;
    closeDropdown();
    currentAnchorEl = anchorEl;

    const dd = document.createElement('div');
    dd.className = 'vsm-dropdown';
    dd.style.position = 'fixed';

    function renderOptions() {
      dd.innerHTML = '';
      items.forEach(function (item) {
        const opt = document.createElement('div');
        opt.className = 'vsm-opt' + (item.isChecked() ? ' vsm-cur' : '');
        opt.textContent = item.text;
        opt.addEventListener('mousedown', function (e) { e.stopPropagation(); });
        opt.addEventListener('click', function (e) {
          e.stopPropagation();
          item.select();
          if (multi) {
            setTimeout(function () { renderOptions(); }, 80);
            setTimeout(function () { renderOptions(); }, 220);
          } else {
            closeDropdown();
            setTimeout(function () { renderAll(); }, 80);
            setTimeout(function () { renderAll(); }, 220);
          }
        });
        dd.appendChild(opt);
      });
    }
    renderOptions();

    dd.style.visibility = 'hidden';
    document.body.appendChild(dd);

    const dr = dd.getBoundingClientRect();
    const ar = anchorEl.getBoundingClientRect();
    let top = ar.bottom + 6;
    let left = ar.left;
    if (top + dr.height > window.innerHeight - 8) top = Math.max(8, ar.top - dr.height - 6);
    if (left + dr.width > window.innerWidth - 8) left = window.innerWidth - dr.width - 8;
    if (left < 8) left = 8;
    if (top < 8) top = 8;

    dd.style.top = top + 'px';
    dd.style.left = left + 'px';
    dd.style.minWidth = Math.max(dr.width, ar.width) + 'px';
    dd.style.visibility = '';
    currentDropdown = dd;
  }

  document.addEventListener('mousedown', function (e) {
    if (!currentDropdown) return;
    if (currentDropdown.contains(e.target)) return;
    if (e.target.closest && e.target.closest('.vsm-chip, .vsm-tag, .vsm-check, .vsm-quick-btn')) return;
    closeDropdown();
  }, true);
  window.addEventListener('scroll', function () { if (currentDropdown) closeDropdown(); }, true);

  /* ============================================================
   *  六、样式
   * ============================================================ */

  const CSS = `
